# ── Storage backend ────────────────────────────────────────────────────────────
# redis: dev / single node (needs `make redis`).  raft: integrated HA storage.
STORAGE=redis

# Local backend port (Vault's conventional 8200). Must match Makefile BACKEND_PORT.
BIND_ADDR=127.0.0.1:8200

# Versions kept per KV secret before the oldest is pruned.
KV_MAX_VERSIONS=10

# ── STORAGE=redis (see docs/REDIS.md) ─────────────────────────────────────────
# standalone | sentinel | cluster
REDIS_MODE=standalone
REDIS_URL=redis://127.0.0.1:6380
# REDIS_SENTINELS=10.0.0.1:26379,10.0.0.2:26379,10.0.0.3:26379
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_CLUSTER_NODES=10.0.0.1:6379,10.0.0.2:6379,10.0.0.3:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false
# Replicas that must confirm each write before it's acknowledged (1 recommended with replicas).
REDIS_WAIT_REPLICAS=0
REDIS_WAIT_TIMEOUT_MS=1000
REDIS_TIMEOUT_MS=3000
# Keys are {prefix}:<path> — the braces are a Cluster hash tag.
TIMIKA_PREFIX=timika

# ── STORAGE=raft ──────────────────────────────────────────────────────────────
# (for a local 3-node cluster just run `make raft-dev` instead)
# RAFT_NODE_ID=timika-0                       # unique, stable (defaults to $HOSTNAME)
# RAFT_PATH=./data/raft                        # this node's redb file lives here
# CLUSTER_BIND_ADDR=127.0.0.1:8201             # raft RPC listener
# API_ADDR=http://127.0.0.1:8200               # how peers reach this node's API
# CLUSTER_ADDR=http://127.0.0.1:8201           # how peers reach this node's raft port
# RAFT_RETRY_JOIN=http://10.0.0.2:8200,http://10.0.0.3:8200
# RAFT_SNAPSHOT_THRESHOLD=8192
# RAFT_TRAILING_LOGS=10000

# ── Auto-unseal (docs/AUTO-UNSEAL.md) ──────────────────────────────────────────
# shamir (default: operators unseal) | transit | awskms | static
SEAL_TYPE=shamir
# SEAL_TRANSIT_ADDR=https://vault.example:8200
# SEAL_TRANSIT_KEY=timika-unseal
# SEAL_TRANSIT_TOKEN_FILE=/etc/timika/transit-token
# SEAL_AWSKMS_KEY_ID=alias/timika-unseal
# SEAL_AWSKMS_REGION=eu-west-1
# SEAL_STATIC_KEY_FILE=/run/secrets/timika_seal_key

# ── TLS (both listeners + peer calls) ─────────────────────────────────────────
# TLS_CERT_FILE=/etc/timika/tls/tls.crt
# TLS_KEY_FILE=/etc/timika/tls/tls.key
# TLS_CA_FILE=/etc/timika/tls/ca.crt

# ── Sign-in (docs/LOGIN.md) ────────────────────────────────────────────────────
LOGIN_POLICY=us-nist                 # us-nist | cn-mlps
# Two-factor authentication (TOTP apps + recovery codes): off | admins | all.
# When required, people without it set it up right after signing in.
MFA_REQUIRED=off
# Name shown in authenticator apps.
MFA_ISSUER=Timika
CAPTCHA_PROVIDER=pow                 # pow | turnstile | recaptcha | hcaptcha | geetest | tencent | none
CAPTCHA_FALLBACK=pow
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=
# CAPTCHA_RECAPTCHA_DOMAIN=www.recaptcha.net   # reachable from mainland China
# LOGIN_BANNER=...
# LOGIN_BANNER_ZH=...
# PRIVACY_NOTICE_URL=https://example.com/privacy
# TRUST_X_FORWARDED_FOR=true         # only behind a proxy you control

# ── Logs (docs/LOGGING.md) ─────────────────────────────────────────────────────
LOG_LEVEL=info,anveesa_timika_backend=debug,openraft=warn
LOG_FORMAT=text
LOG_DIR=./data/logs
LOG_ROTATION=daily
LOG_MAX_FILES=14
# Audit log: hash-chained, fail-closed. {instance} = this instance's id.
AUDIT_FILE=./data/logs/audit-{instance}.log
AUDIT_FILE_MAX_MB=100
AUDIT_FILE_MAX_FILES=10
# AUDIT_SYSLOG=udp://127.0.0.1:514
# AUDIT_FAIL_CLOSED=true
